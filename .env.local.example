# Copy to .env.local and fill in. Never commit .env.local.

# Supabase -> Project Settings -> Data API / API Keys
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The service_role key, not the anon key. Server-side only; it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for /recipes. https://console.anthropic.com
ANTHROPIC_API_KEY=
