# Copy to .env.local and fill in. Never commit .env.local.

# Supabase -> Project Settings -> Data API / API Keys
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The service_role key, not the anon key. Server-side only; it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for /recipes. https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Access control -------------------------------------------------------
# What you type once per device at /unlock. Without it the app stays locked,
# so this is required. Changing it signs every device out.
#   Generate:  openssl rand -base64 24
APP_PASSPHRASE=

# Optional. If set, the NFC tag URL can carry ?k=<TAG_KEY> to unlock in one tap
# with nothing to type at the fridge. Leave blank to require the passphrase on
# every new device. Keep it different from APP_PASSPHRASE so it rotates alone.
#   Generate:  openssl rand -hex 32
TAG_KEY=
